{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4b5c64",
      "titleColor": "#4b5c64",
      "titleFontWeight": 500,
      "gridColor": "#e8e6df",
      "domain": false,
      "ticks": false,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4b5c64",
      "titleColor": "#4b5c64",
      "symbolType": "square"
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#213b48"
    }
  },
  "data": {
    "url": "data/historical-composition.json"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.92
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null
        },
        "y": {
          "field": "share",
          "type": "quantitative",
          "stack": "zero",
          "title": "Market capitalisation share (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Financial",
              "Other",
              "Resources"
            ],
            "range": [
              "#254f67",
              "#cbd9d5",
              "#bf693b"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null
          }
        },
        "order": {
          "field": "sector",
          "type": "nominal",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Quarter",
            "format": "%b %Y"
          },
          {
            "field": "sector",
            "type": "nominal",
            "title": "Historical sector"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Market share (%)",
            "format": ".1f"
          },
          {
            "field": "population",
            "type": "nominal",
            "title": "Companies covered"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "1980-01-01"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#fff",
        "strokeWidth": 2,
        "strokeDash": [
          5,
          4
        ]
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "1980-01-01",
            "label": "1980\ncoverage changes"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": 8,
        "color": "#213b48",
        "fontSize": 12,
        "baseline": "top",
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "name": "resources_insight",
      "transform": [
        {
          "filter": "datum.sector === 'Resources' && month(toDate(datum.date)) === 2 && (year(toDate(datum.date)) === 1980 || year(toDate(datum.date)) === 2019)"
        },
        {
          "window": [
            {
              "op": "first_value",
              "field": "share",
              "as": "start_share"
            },
            {
              "op": "last_value",
              "field": "share",
              "as": "end_share"
            }
          ],
          "sort": [
            {
              "field": "date",
              "order": "ascending"
            }
          ],
          "frame": [
            null,
            null
          ]
        },
        {
          "filter": "year(toDate(datum.date)) === 2019"
        },
        {
          "calculate": "'1980–2019, same coverage\\nResources lost ' + format(datum.start_share - datum.end_share, '.1f') + ' percentage points'",
          "as": "insight"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "dy": 23,
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#213b48",
        "lineBreak": "\n",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "value": 0
        },
        "text": {
          "condition": {
            "test": "width >= 700",
            "field": "insight"
          },
          "value": ""
        },
        "tooltip": null
      }
    }
  ],
  "title": {
    "text": "Compare within each coverage period",
    "fontSize": 13,
    "fontWeight": 500,
    "subtitle": [
      "Before 1980: historical top 100; from 1980: whole-exchange series"
    ],
    "subtitleFontSize": 12,
    "subtitleColor": "#4b5c64",
    "offset": 12
  }
}
