                    "title": "Country / Territory"
                  },
                  {
                    "field": "count",
                    "type": "quantitative",
                    "title": "Number of ASX-listed Foreign Entities",
                    "format": ".0f"
                  },
                  {
                    "field": "report_share",
                    "type": "quantitative",
                    "title": "Share of Total (%)",
                    "format": ".1%"
                  }
                ]
              },
              "transform": [
                {
                  "filter": "indexof([\"United Kingdom\", \"Ireland\"], datum.country) >= 0"
                }
              ]
            },
            {
              "data": {
                "url": "data/foreign-entity-countries.json"
              },
              "transform": [
                {
                  "filter": "indexof([\"United Kingdom\", \"Ireland\"], datum.country) >= 0"
