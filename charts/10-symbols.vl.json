{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4b5c64",
      "titleColor": "#4b5c64",
      "titleFontWeight": 500,
      "gridColor": "#e8e6df",
      "domain": false,
      "ticks": false,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4b5c64",
      "titleColor": "#4b5c64",
      "symbolType": "square"
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#213b48"
    }
  },
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "spacing": 28,
  "title": {
    "text": "135 entities · 13 incorporation jurisdictions",
    "subtitle": [
      "ASX Foreign Entity Report · 30 September 2026",
      "136 security codes; News Corporation counted once"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "subtitleColor": "#4b5c64",
    "subtitlePadding": 8,
    "subtitleLineHeight": 18,
    "offset": 18
  },
  "description": "Where are the foreign entities covered by the September 2026 ASX report incorporated? Circle AREA represents distinct entity count; geographic anchors are Natural Earth country label points, not company locations.",
  "usermeta": {
    "idiom": "proportional-symbol map",
    "population": "135 distinct named entities in the September 2026 Foreign Entity Report; 136 security codes",
    "exclusions": "Australian-incorporated entities are outside this report; source also excludes foreign components of stapled securities and other specified securities",
    "source": "ASX Foreign Entity Report, 30 September 2026",
    "source_url": "https://www.asx.com.au/content/dam/asx/documents/listings/foreign-entity-data/2026/asx-foreign-entity-report-20260930.xlsx",
    "coordinates": "Natural Earth 50m Admin-0 LABEL_X / LABEL_Y, not company addresses",
    "duplicates": "NWS and NWSLV are two security classes of News Corporation: one entity, two raw records",
    "inset_note": "Geographic enlargements repeat existing entities; do not add their counts to the world view"
  },
  "vconcat": [
    {
      "width": 900,
      "height": 365,
      "projection": {
        "type": "equalEarth"
      },
      "title": {
        "text": "World view",
        "anchor": "start",
        "fontSize": 15,
        "color": "#213b48",
        "offset": 12
      },
      "layer": [
        {
          "data": {
            "url": "data/world-countries.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#e9eae3",
            "stroke": "#fffefa",
            "strokeWidth": 0.6
          }
        },
        {
          "data": {
            "url": "data/foreign-entity-countries.json"
          },
          "mark": {
            "type": "circle",
            "color": "#254f67",
            "opacity": 0.8,
            "stroke": "#fffefa",
            "strokeWidth": 1.4
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "count",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  53
                ],
                "range": [
                  0,
                  2000
                ]
              },
              "legend": {
                "title": "Entities · circle area",
                "orient": "bottom",
                "values": [
                  5,
                  20,
                  53
                ],
                "symbolType": "circle",
                "titleFontSize": 14,
                "labelFontSize": 14,
                "titleColor": "#213b48",
                "labelColor": "#213b48",
                "titlePadding": 12,
                "labelOffset": 8,
                "padding": 8,
                "columnPadding": 20
              }
            },
            "tooltip": [
              {
                "field": "country",
                "type": "nominal",
                "title": "Country / Territory"
              },
              {
                "field": "count",
                "type": "quantitative",
                "title": "Number of ASX-listed Foreign Entities",
                "format": ".0f"
              },
              {
                "field": "report_share",
                "type": "quantitative",
                "title": "Share of Total (%)",
                "format": ".1%"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/foreign-entity-countries.json"
          },
          "transform": [
            {
              "filter": "indexof(['NZL','CAN','USA'], datum.iso_a3) >= 0"
            },
            {
              "calculate": "datum.country === 'United States of America' ? 'United States · ' + datum.count : datum.country + ' · ' + datum.count",
              "as": "label"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 600,
            "color": "#213b48",
            "align": {
              "expr": "datum.iso_a3 === 'NZL' ? 'right' : 'left'"
            },
            "dx": {
              "expr": "datum.iso_a3 === 'NZL' ? -29 : 24"
            },
            "dy": -17
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "hconcat": [
        {
          "width": 415,
          "height": 185,
          "projection": {
            "type": "mercator",
            "fit": {
              "type": "Feature",
              "geometry": {
                "type": "Polygon",
                "coordinates": [
                  [
                    [
                      -13,
                      48
                    ],
                    [
                      -13,
                      61
                    ],
                    [
                      3,
                      61
                    ],
                    [
                      3,
                      48
                    ],
                    [
                      -13,
                      48
                    ]
