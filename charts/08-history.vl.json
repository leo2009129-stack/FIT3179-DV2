{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4b5c64",
      "titleColor": "#4b5c64",
      "titleFontWeight": 500,
      "gridColor": "#e8e6df",
      "domain": false,
      "ticks": false,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4b5c64",
      "titleColor": "#4b5c64",
      "symbolType": "square"
    },
    "title": {
      "fontSize": 16,
      "anchor": "start",
      "color": "#213b48"
    }
  },
  "data": {
    "url": "data/historical-composition.json"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.92
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null
        },
        "y": {
          "field": "share",
          "type": "quantitative",
          "stack": "zero",
          "title": "Market capitalisation share (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Financial",
              "Other",
              "Resources"
            ],
            "range": [
              "#254f67",
              "#cbd9d5",
              "#bf693b"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null
          }
        },
        "order": {
          "field": "sector",
          "type": "nominal",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Quarter",
            "format": "%b %Y"
          },
          {
            "field": "sector",
            "type": "nominal"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Market share (%)",
            "format": ".1f"
          },
          {
            "field": "population",
            "type": "nominal"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "1980-01-01"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#fff",
        "strokeWidth": 2,
        "strokeDash": [
          5,
          4
        ]
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "1980-01-01",
            "label": "1980 \u00b7 coverage changes"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 12,
        "color": "#213b48",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
